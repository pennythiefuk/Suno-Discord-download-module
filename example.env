# Rename this file to .env (and never share it or upload it anywhere).

# Your Discord bot's token (only needed for example-bot.js — your own bot already has one somewhere).
DISCORD_TOKEN=

# OPTIONAL: a __client token from a THROWAWAY Suno account, for searching every public song.
# Leave empty to search Suno's public Explore lists instead. See "BROADER SEARCH" in README.txt.
SUNO_CLIENT_TOKEN=
